{
  "name": "local_smart_desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-backend/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "vite",
    "dev:backend": "tsx watch src/main/index.ts",
    "dev:desktop": "npm run build:backend && concurrently -k \"npm run dev:frontend\" \"wait-on http://localhost:5173 && electron --no-sandbox --disable-dev-shm-usage dist-backend/main/index.js\"",
    "desktop:window": "electron --no-sandbox --disable-dev-shm-usage dist-backend/main/index.js",
    "build:backend": "tsc -p tsconfig.server.json && cp src/main/preload.cjs dist-backend/main/preload.cjs",
    "build:frontend": "tsc -b && vite build",
    "build": "npm run build:backend && npm run build:frontend",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^44.4.1",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.7.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "wait-on": "^9.1.0"
  }
}
